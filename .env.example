# 32자 이상 임의 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# 로컬(http) 개발 시 false, 운영(HTTPS)은 true
COOKIE_SECURE=false
# 개발용 닉네임 로그인. 운영에서는 반드시 false
ALLOW_DEV_LOGIN=true
# Google 로그인(추후 단계)
GOOGLE_CLIENT_ID=
# 프론트를 다른 출처에서 띄울 때만 (쉼표 구분)
ALLOWED_ORIGINS=
DATA_DIR=./data
# 수수료/세율 (필요 시 조정)
BUY_FEE_RATE=0.00015
SELL_FEE_RATE=0.00015
SELL_TAX_RATE=0.0018
